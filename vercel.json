{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "app": {
        "root": "./",
        "framework": "fastapi"
      },
      "web": {
        "root": "web",
        "framework": "vite"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "app"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "web"
        }
      }
    ]
  }